{
  "name": "react-native-toastify-expo",
  "main": "lib/index.js",
  "version": "1.1.3",
  "description": "Type-safe, animated toast notifications for React Native and Expo with auto-dismiss",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "eslint src --ext .ts,.tsx",
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react-native",
    "toast",
    "notification",
    "alert",
    "expo",
    "react",
    "toastify",
    "toast-notification",
    "snackbar",
    "react-native-toast",
    "expo-toast",
    "typescript"
  ],
  "author": "Anujkumar Yadav",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anuj-kumary/react-native-toastify.git"
  },
  "bugs": {
    "url": "https://github.com/anuj-kumary/react-native-toastify/issues"
  },
  "homepage": "https://github.com/anuj-kumary/react-native-toastify#readme",
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.60.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-native": "~0.73.0",
    "@types/react-test-renderer": "^18.3.0",
    "jest": "^30.5.2",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.3.3"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
